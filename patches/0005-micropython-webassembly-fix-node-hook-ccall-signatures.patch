From 19502b3d7cc06c9db4dc1d09790a4980f7036dc5 Mon Sep 17 00:00:00 2001
From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Sun, 23 Aug 2026 10:10:00 -0500
Subject: [PATCH] webassembly: fix node hook ccall signatures

Module.ccall takes an array of argument TYPES and an array of arguments;
["null"] is neither. Upstream v1.29.0 already corrected the
mp_hal_get_interrupt_char call this way, leaving only
mp_sched_keyboard_interrupt.

Based-on: micropython 0fd6c573e (tag v1.29.0)
---
 ports/webassembly/library.js | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ports/webassembly/library.js b/ports/webassembly/library.js
index 6fcd9f2e2..0c38cce33 100644
--- a/ports/webassembly/library.js
+++ b/ports/webassembly/library.js
@@ -48,8 +48,8 @@ mergeInto(LibraryManager.library, {
                         Module.ccall(
                             "mp_sched_keyboard_interrupt",
                             "null",
-                            ["null"],
-                            ["null"],
+                            [],
+                            [],
                         );
                     } else {
                         process.stdout.write(String.fromCharCode(buf[0]));
-- 
2.43.0

