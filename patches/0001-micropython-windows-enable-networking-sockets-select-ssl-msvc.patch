+static mp_obj_t socket_connect(mp_obj_t self_in, mp_obj_t addr_in) {
+    mp_obj_socket_t *self = MP_OBJ_TO_PTR(self_in);
+    mp_buffer_info_t bufinfo;
+    mp_get_buffer_raise(addr_in, &bufinfo, MP_BUFFER_READ);
+
+    // special case of PEP 475 to retry only if blocking so we can't use
+    // MP_HAL_RETRY_SYSCALL() here
+    for (;;) {
+        #ifdef _WIN32
+        self->connect_started = true;
+        // Winsock connect() ignores SO_*TIMEO. For a timed blocking connect:
+        // temporarily go non-blocking, connect, then select for writability.
+        const DWORD timeout = get_socket_timeout(self->fd, false);
+        const bool use_timeout = (timeout > 0 && self->blocking);
+        if (use_timeout) {
+            u_long non_block = 1;
+            MP_THREAD_GIL_EXIT();
+            int ir = ioctlsocket(self->fd, FIONBIO, &non_block);
+            MP_THREAD_GIL_ENTER();
+            RAISE_ERRNO(ir, WSAGetLastError());
+        }
+        #endif
+        MP_THREAD_GIL_EXIT();
+        int r = connect(self->fd, (const struct sockaddr *)bufinfo.buf, bufinfo.len);
+        int err = (r == -1) ? socket_errno : 0;
+        MP_THREAD_GIL_ENTER();
+        #ifdef _WIN32
+        if (use_timeout) {
+            if (r == -1 && (err == WSAEWOULDBLOCK || err == WSAEINPROGRESS)) {
+                fd_set fdset;
+                FD_ZERO(&fdset);
+                FD_SET(self->fd, &fdset);
+                struct timeval tv;
+                tv.tv_sec = timeout / 1000;
+                tv.tv_usec = (timeout % 1000) * 1000;
+                MP_THREAD_GIL_EXIT();
+                r = select(1, NULL, &fdset, NULL, &tv);
+                if (r > 0) {
+                    int so_error = 0;
+                    int opt_len = sizeof(so_error);
+                    getsockopt(self->fd, SOL_SOCKET, SO_ERROR, (char *)&so_error, &opt_len);
+                    err = so_error;
+                    r = (so_error == 0) ? 0 : -1;
+                } else if (r == 0) {
+                    err = MP_ETIMEDOUT;
+                    r = -1;
+                } else {
+                    err = WSAGetLastError();
+                    r = -1;
+                }
+                MP_THREAD_GIL_ENTER();
+            }
+            u_long block = 0;
+            MP_THREAD_GIL_EXIT();
+            (void)ioctlsocket(self->fd, FIONBIO, &block);
+            MP_THREAD_GIL_ENTER();
+            if (r == -1) {
+                mp_raise_OSError(err);
+            }
+            return mp_const_none;
+        }
+        #endif
+        if (r == -1) {
+            if (self->blocking) {
+                if (err == socket_eintr) {
+                    mp_handle_pending(MP_HANDLE_PENDING_CALLBACKS_AND_EXCEPTIONS);
+                    continue;
+                }
+                // EINPROGRESS on a blocking socket means the operation timed out
+                if (err == EINPROGRESS) {
+                    err = MP_ETIMEDOUT;
+                }
+            } else {
+                #ifdef _WIN32
+                // Winsock reports WSAEWOULDBLOCK for non-blocking connect-in-progress;
+                // map to POSIX EINPROGRESS so asyncio.open_connection can wait on POLLOUT.
+                if (err == WSAEWOULDBLOCK || err == WSAEINPROGRESS) {
+                    err = MP_EINPROGRESS;
+                }
+                #endif
+            }
+            mp_raise_OSError(err);
+        }
+        return mp_const_none;
+    }
+}
+static MP_DEFINE_CONST_FUN_OBJ_2(socket_connect_obj, socket_connect);
