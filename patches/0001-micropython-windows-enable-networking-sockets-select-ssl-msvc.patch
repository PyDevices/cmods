diff --git a/extmod/modselect.c b/extmod/modselect.c
index 229f8f737..66ec666ba 100644
--- a/extmod/modselect.c
+++ b/extmod/modselect.c
@@ -39,6 +39,12 @@
 #error "select.select is not supported with MICROPY_PY_SELECT_POSIX_OPTIMISATIONS"
 #endif
 
+#if defined(_WIN32) && !MICROPY_PY_SELECT_POSIX_OPTIMISATIONS
+// Winsock select() is used to sleep until socket readiness; plain Sleep() cannot
+// be interrupted by network events (see poll_set_poll_until_ready_or_timeout).
+#include <winsock2.h>
+#endif
+
 #if MICROPY_PY_SELECT_POSIX_OPTIMISATIONS
 
 #include <string.h>
@@ -404,11 +410,63 @@ static mp_uint_t poll_set_poll_until_ready_or_timeout(poll_set_t *poll_set, size
         if (n_ready > 0 || (has_timeout && elapsed >= timeout)) {
             return n_ready;
         }
+        #if defined(_WIN32)
+        // On Windows, mp_event_wait_ms() is an uninterruptible sleep.  Socket
+        // readiness is only visible via ioctl(MP_STREAM_POLL) (non-blocking
+        // select).  Block in Winsock select() so incoming connections/data wake
+        // us instead of waiting out the full asyncio/select timeout.
+        fd_set rfds, wfds, efds;
+        FD_ZERO(&rfds);
+        FD_ZERO(&wfds);
+        FD_ZERO(&efds);
+        bool any_fd = false;
+        for (mp_uint_t i = 0; i < poll_set->map.alloc; ++i) {
+            if (!mp_map_slot_is_filled(&poll_set->map, i)) {
+                continue;
+            }
+            poll_obj_t *poll_obj = MP_OBJ_TO_PTR(poll_set->map.table[i].value);
+            int errcode = 0;
+            mp_uint_t fd = poll_obj->ioctl(poll_obj->obj, MP_STREAM_GET_FILENO, 0, &errcode);
+            if (fd == (mp_uint_t)-1 || fd == (mp_uint_t)MP_STREAM_ERROR) {
+                continue;
+            }
+            mp_uint_t events = poll_obj_get_events(poll_obj);
+            SOCKET s = (SOCKET)fd;
+            if (events & MP_STREAM_POLL_RD) {
+                FD_SET(s, &rfds);
+            }
+            if (events & MP_STREAM_POLL_WR) {
+                FD_SET(s, &wfds);
+            }
+            FD_SET(s, &efds);
+            any_fd = true;
+        }
+        if (any_fd) {
+            struct timeval tv;
+            struct timeval *ptv = NULL;
+            if (has_timeout) {
+                mp_uint_t rem = timeout - elapsed;
+                tv.tv_sec = rem / 1000;
+                tv.tv_usec = (rem % 1000) * 1000;
+                ptv = &tv;
+            }
+            MP_THREAD_GIL_EXIT();
+            // First argument is ignored on Windows.
+            (void)select(0, &rfds, &wfds, &efds, ptv);
+            MP_THREAD_GIL_ENTER();
+            mp_event_handle_nowait();
+        } else if (has_timeout) {
+            mp_event_wait_ms(timeout - elapsed);
+        } else {
+            mp_event_wait_indefinite();
+        }
+        #else
         if (has_timeout) {
             mp_event_wait_ms(timeout - elapsed);
         } else {
             mp_event_wait_indefinite();
         }
+        #endif
     }
 
     #endif
