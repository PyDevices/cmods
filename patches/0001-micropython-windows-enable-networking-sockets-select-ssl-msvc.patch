+// Note: besides flag param, this differs from read() in that
+// this does not swallow blocking errors (EAGAIN, EWOULDBLOCK) -
+// these would be thrown as exceptions.
+static mp_obj_t socket_recv(size_t n_args, const mp_obj_t *args) {
+    mp_obj_socket_t *self = MP_OBJ_TO_PTR(args[0]);
+    int sz = mp_obj_get_int(args[1]);
+    int flags = 0;
+
+    if (n_args > 2) {
+        flags = mp_obj_get_int(args[2]);
+    }
+
+    byte *buf = m_new(byte, sz);
+    socket_size_t out_sz;
+    #ifdef _WIN32
+    const bool restore_blocking = socket_begin_dontwait(self, &flags);
+    const bool timed_blocking = self->blocking && !restore_blocking;
+    #endif
+    MP_HAL_RETRY_SYSCALL(out_sz, recv(self->fd, (char *)buf, sz, flags), {
+        #ifdef _WIN32
+        // Winsock truncated datagram / peek: buffer filled with first `sz` bytes.
+        if (err == WSAEMSGSIZE) {
+            out_sz = sz;
+            break;
+        }
+        err = translate_wsa_errno(err);
+        socket_end_dontwait(self, restore_blocking);
+        // Blocking recv timed out via SO_RCVTIMEO (not MSG_DONTWAIT).
+        if (timed_blocking && err == MP_EAGAIN) {
+            err = MP_ETIMEDOUT;
+        }
+        #else
+        if (self->blocking && !(flags & MSG_DONTWAIT) && err == EAGAIN) {
+            err = MP_ETIMEDOUT;
+        }
+        #endif
+        mp_raise_OSError(err);
+    });
+    #ifdef _WIN32
+    socket_end_dontwait(self, restore_blocking);
+    #endif
+    mp_obj_t ret = mp_obj_new_str_of_type(&mp_type_bytes, buf, out_sz);
+    m_del(char, buf, sz);
+    return ret;
+}
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(socket_recv_obj, 2, 3, socket_recv);
