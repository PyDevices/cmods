From 5f4da11af8bd49b6f6f1d36ad3637369358d558f Mon Sep 17 00:00:00 2001
From: Brad Barnett <127794626+bdbarnett@users.noreply.github.com>
Date: Sun, 23 Aug 2026 10:00:00 -0500
Subject: [PATCH] webassembly: support soft reinitialization

Export mp_js_deinit, keep the pystack and heap pointers at file scope so it can
free what mp_js_init allocated, and add a softReset() to the JS API that tears
down and re-initialises in place.

Based-on: micropython 0fd6c573e (tag v1.29.0)
---
 ports/webassembly/Makefile |  1 +
 ports/webassembly/api.js   | 12 ++++++++++++
 ports/webassembly/main.c   | 25 +++++++++++++++++++++----
 3 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/ports/webassembly/Makefile b/ports/webassembly/Makefile
index 827cd46aa..cf6ff7dc3 100644
--- a/ports/webassembly/Makefile
+++ b/ports/webassembly/Makefile
@@ -82,6 +82,7 @@ JSFLAGS += -s EXPORTED_FUNCTIONS="\
 	_free,\
 	_malloc,\
 	_mp_js_init,\
+	_mp_js_deinit,\
 	_mp_js_repl_init,\
 	_mp_js_repl_process_char,\
 	_mp_hal_get_interrupt_char,\
diff --git a/ports/webassembly/api.js b/ports/webassembly/api.js
index 8e15438d1..a6277d5e7 100644
--- a/ports/webassembly/api.js
+++ b/ports/webassembly/api.js
@@ -132,6 +132,18 @@ export async function loadMicroPython(options) {
             );
             Module._free(value);
         },
+        softReset() {
+            Module.ccall("mp_js_deinit", "null", [], []);
+            proxy_js_init();
+            Module.ccall(
+                "mp_js_init",
+                "null",
+                ["number", "number"],
+                [pystack, heapsize],
+            );
+            Module.ccall("proxy_c_init", "null", [], []);
+            this.globals.__dict__ = pyimport("__main__").__dict__;
+        },
         pyimport: pyimport,
         runPython(code) {
             const len = Module.lengthBytesUTF8(code);
diff --git a/ports/webassembly/main.c b/ports/webassembly/main.c
index 670d404da..544a2e4b5 100644
--- a/ports/webassembly/main.c
+++ b/ports/webassembly/main.c
@@ -54,6 +54,9 @@ static size_t external_call_depth = 0;
 // Emscripten defaults to a 64k C-stack, so our limit should be less than that.
 #define CSTACK_SIZE (32 * 1024)
 
+static void *mp_js_pystack;
+static void *mp_js_heap;
+
 #if MICROPY_GC_SPLIT_HEAP_AUTO
 static void gc_collect_top_level(mp_obj_t root_obj);
 #endif
@@ -77,13 +80,13 @@ void mp_js_init(int pystack_size, int heap_size) {
     mp_cstack_init_with_sp_here(CSTACK_SIZE);
 
     #if MICROPY_ENABLE_PYSTACK
-    mp_obj_t *pystack = (mp_obj_t *)malloc(pystack_size * sizeof(mp_obj_t));
-    mp_pystack_init(pystack, pystack + pystack_size);
+    mp_js_pystack = malloc(pystack_size * sizeof(mp_obj_t));
+    mp_pystack_init(mp_js_pystack, (mp_obj_t *)mp_js_pystack + pystack_size);
     #endif
 
     #if MICROPY_ENABLE_GC
-    char *heap = (char *)malloc(heap_size * sizeof(char));
-    gc_init(heap, heap + heap_size);
+    mp_js_heap = malloc(heap_size);
+    gc_init(mp_js_heap, (char *)mp_js_heap + heap_size);
     #endif
 
     #if MICROPY_GC_SPLIT_HEAP_AUTO
@@ -110,6 +113,20 @@ void mp_js_init(int pystack_size, int heap_size) {
     #endif
 }
 
+void mp_js_deinit(void) {
+    #if defined(MICROPY_PY_WASM_BRIDGE) && MICROPY_PY_WASM_BRIDGE
+    extern void pydevices_bridge_deinit(void);
+    pydevices_bridge_deinit();
+    #endif
+    mp_deinit();
+    free(mp_js_heap);
+    mp_js_heap = NULL;
+    #if MICROPY_ENABLE_PYSTACK
+    free(mp_js_pystack);
+    mp_js_pystack = NULL;
+    #endif
+}
+
 void mp_js_register_js_module(const char *name, uint32_t *value) {
     mp_obj_t module_name = MP_OBJ_NEW_QSTR(qstr_from_str(name));
     mp_obj_t module = proxy_convert_js_to_mp_obj_cside(value);
-- 
2.43.0

