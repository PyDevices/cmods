+# usbif: USB host settings the module needs, kept in their own fragment so a
+# MicroPython release cannot conflict with them.
+#
+# Enable external USB hub support in the IDF host library. Off by default
+# upstream, which means a hub enumerates as a device the host stack cannot use
+# and everything behind it is invisible -- the reason a flash drive behind a
+# powered hub never appeared during Phase 2 testing. Costs code size in every
+# build; worth it because host work beyond one device needs it, and because a
+# powered hub is also how boards that cannot source VBUS reach a bus-powered
+# peripheral at all.
+CONFIG_USB_HOST_HUBS_SUPPORTED=y
+
+# Raise the control-transfer buffer well above the 256-byte default. IDF
+# allocates one buffer per attached device for its control endpoint, and its own
+# Kconfig help states the consequence plainly: "Device's with configuration
+# descriptors larger than this limit cannot be supported." 256 bytes suits
+# simple peripherals and is far too small for media devices: a USB audio CODEC
+# on this bench publishes a 1191-byte configuration descriptor (24 alternate
+# settings across two AudioStreaming interfaces) and simply never enumerates at
+# the default -- no error, no event, the device is absent, while a 153-byte
+# microphone on the same hub attaches in one second. UVC descriptors are larger
+# again, so this is a Phase 6 prerequisite too.
+CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
+
+# Bias the host FIFOs toward IN. A real board-wide trade-off with no setting
+# that serves everything, and the three presets decide it: Balanced is IN 408 /
+# periodic OUT 192, Periodic OUT is IN 128 / OUT 600, Bias IN is IN 600 / OUT
+# 128. Hosting a camera needs a 512-byte isochronous IN endpoint even at a
+# modest mode, so a periodic-OUT bias caps IN at 128 and makes interface_claim
+# refuse the camera outright with ESP_ERR_NOT_SUPPORTED -- a claim failure that
+# says nothing about packet sizes. IN bias costs periodic OUT 600 -> 128, which
+# still carries 48 kHz mono but not stereo. The real fix is picking this at
+# runtime from the classes host_start() was asked for:
+# usb_host_config_t.fifo_settings_custom allows exactly that.
+CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
