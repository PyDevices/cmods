# Shared minimum (PyDevices package / cmod repos)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Cursor IDE throwaways
.cursor/debug*
.cursor/plans/

# Workspace-specific personal files at root
manifest-user.*
main.py
user_post_mpconfigport.mk

# Ignore all top-level directories (root files stay trackable by default)…
# New tracked trees must be explicitly re-added below (esp32_partitions/
# was silently ignored here for a while — nothing complained, the ESP32-P4
# build just quietly built without its partition table).
/*/
# …except the tracked workspace tooling trees
!/.github/
!/.github/**
!/.site/
!/.site/**
!/patches/
!/patches/**
!/scripts/
!/scripts/**
!/variants/
!/variants/**
!/wasmbridge/
!/wasmbridge/**
# small csv+sdkconfig files the ESP32-P4 build depends on; see build_mp.sh's
# esp32_partition_override()
!/esp32_partitions/
!/esp32_partitions/**
# board overlays: a directory that includes one of MicroPython's own boards and
# changes one thing, passed as BOARD_DIR=. Source, not output -- see
# esp32_boards/README.md
!/esp32_boards/
!/esp32_boards/**
# The .csv files in there are SOURCE again, and tracked, as of cmods#30. They
# used to be build output, because esp32_autosize_partition() wrote a resized
# table back over the file it read -- so a board's filesystem offset tracked how
# big somebody's last firmware was, and two images built the same day for the
# same board had different layouts with nothing saying so. No build writes them
# now: an overflow refuses and prints the table that would fit, and MP_AUTOSIZE=1
# keeps its enlarged copy inside the build directory. Tracked means drift in a
# board's flash layout shows up in `git status`, which is the whole point.

# Top-level symlinks to clones/siblings (/* / does not match symlinks)
/audiodsp
/audioif
/cameraif
/displayif
/earful
/pygraphics
/usbif
/pdwidgets
/palettes
/usdl2
/lvgl-*
/micropython
/circuitpython
/ulab
/emsdk
/esp-idf
/SDL2-*
/lvgl
.build.lock

# Generated by scripts/provenance.py freeze during a build (cmods#36).
