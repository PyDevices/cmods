# Shared minimum (PyDevices package / cmod repos)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Cursor IDE throwaways
.cursor/debug*
.cursor/plans/

# Workspace-specific personal files at root
manifest-user.*
main.py
user_post_mpconfigport.mk

# Ignore all top-level directories (root files stay trackable by default)…
# New tracked trees must be explicitly re-added below (esp32_partitions/
# was silently ignored here for a while — nothing complained, the ESP32-P4
# build just quietly built without its partition table).
/*/
# …except the tracked workspace tooling trees
!/.github/
!/.github/**
!/.site/
!/.site/**
!/patches/
!/patches/**
!/scripts/
!/scripts/**
!/variants/
!/variants/**
!/wasmbridge/
!/wasmbridge/**
# small csv+sdkconfig files the ESP32-P4 build depends on; see build_mp.sh's
# esp32_partition_override()
!/esp32_partitions/
!/esp32_partitions/**
# …but the .csv files in there are build OUTPUT, not source. build_mp.sh's
# esp32_autosize_partition() writes the resized table back over the override
# path it read, so a build that overflows the app partition rewrites the file in
# place -- and creates one from scratch for a BOARD_VARIANT combination that has
# none yet. Tracking them meant every P4 build left the tree dirty with a
# generated file. The sizes are derived (image size, rounded up, plus 0x40000 of
# headroom), so nothing is lost by not keeping them. The .sdkconfig fragments
# beside them ARE hand-written source and stay tracked.
/esp32_partitions/*.csv

# Top-level symlinks to clones/siblings (/* / does not match symlinks)
/audiodsp
/audiopump
/cameraif
/displayif
/earful
/pygraphics
/usbif
/pdwidgets
/palettes
/usdl2
/lvgl-*
/micropython
/circuitpython
/ulab
/emsdk
/esp-idf
/SDL2-*
/lvgl
