# Shared minimum (PyDevices package / cmod repos)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Cursor IDE throwaways (do not ignore the whole .cursor/ tree)
.cursor/debug*
.cursor/plans/

# Workspace-specific — personal frozen manifest / entry
my-manifest.*
main.py

# Local CircuitPython user config (copy from .example)
cp-user-config/user_post_mpconfigport.mk

# All cloned repos/directories at workspace root (micropython, user_cmodules, etc.)
/*/
# Local multi-repo symlinks (gh/pydevices layout — not committed)
/displayif
/pygraphics
/lv_bindings
/lv_circuitpython_mod
/lv_cpython_mod
/lv_micropython_cmod
/usdl2
/micropython
/circuitpython
/emsdk
/esp-idf
/SDL2-*
/lvgl
# Workspace tooling (not upstream clones)
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/.cursor/
!/cp-user-config/
!/.github/
!/.github/**
!/web/
!/web/**
